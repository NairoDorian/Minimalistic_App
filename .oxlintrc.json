{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["src/bindings.ts"],
  "plugins": ["unicorn", "import", "typescript"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn",
    "style": "off",
    "pedantic": "off",
    "nursery": "off",
    "restriction": "off"
  },
  "rules": {
    "no-unused-vars": "error",
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "no-underscore-dangle": ["warn", { "allow": ["__APP_VERSION__"] }],
    "import/no-unassigned-import": "off"
  },
  "overrides": [
    {
      "files": ["scripts/**/*", "test/**/*"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["src/lib/hardening.ts"],
      "rules": {
        "unicorn/consistent-function-scoping": "off"
      }
    }
  ]
}
