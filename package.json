{
  "name": "minimalistic-app",
  "private": true,
  "version": "0.20.0",
  "type": "module",
  "scripts": {
    "vite": "vite",
    "vite:build": "vite build",
    "build": "bun run tauri build",
    "tauri": "tauri",
    "typecheck": "bun x tsc -b",
    "lint": "oxlint src test scripts",
    "lint:fix": "oxlint --fix src test scripts",
    "test": "bun test",
    "rename-project": "bun scripts/rename-project.ts",
    "before-commit": "bun scripts/before-commit.ts",
    "validate": "bun scripts/before-commit.ts --full",
    "arch": "bun scripts/generate-arch.ts",
    "create-icons": "bun scripts/create-icons.ts",
    "update-deps": "bun scripts/update-deps.ts",
    "update:rtk": "bun scripts/update-rtk.ts",
    "format": "prettier --write . && cd src-tauri && cargo fmt",
    "format:check": "prettier --check . && cd src-tauri && cargo fmt -- --check",
    "format:frontend": "prettier --write .",
    "format:backend": "cd src-tauri && cargo fmt",
    "kill": "taskkill /F /IM minimalistic-app.exe 2>nul || exit 0",
    "clean": "cargo clean --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@solidjs/web": "^2.0.0-rc.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "solid-js": "2.0.0-rc.0"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "^3.0.0-next.29",
    "@tauri-apps/cli": "^2.11.4",
    "@types/bun": "^1.3.14",
    "@types/node": "26.2.0",
    "oxlint": "1.79.0",
    "prettier": "4.0.0-alpha.13",
    "repomix": "1.18.0",
    "typescript": "7.1.0-dev.20260818.1",
    "vite": "8.2.1"
  }
}
