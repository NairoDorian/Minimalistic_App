{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Minimalistic App",
  "version": "0.1.0",
  "identifier": "com.minimalistic.app",
  "build": {
    "beforeDevCommand": "vite",
    "beforeBuildCommand": "bun run vite:build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Minimalistic App",
        "width": 440,
        "height": 560,
        "resizable": false,
        "fullscreen": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IFJXVFMvWVlZWUVZWUVZWUVZWUVZWUVZWUVZWUVZWUVZWUVZWUVZWUVZWUVZWUVZWUVZ==",
      "endpoints": [
        "https://github.com/your-username/minimalistic-app/releases/latest/download/latest.json"
      ]
    }
  }
}
