# Node / Bun dependencies
node_modules/

# Lockfiles from other package managers (Bun is the standard)
package-lock.json
yarn.lock
pnpm-lock.yaml

# Rust build artifacts
target/
src-tauri/target/
src-tauri/gen/

# Vite production output
dist/

# OS metadata
.DS_Store
Thumbs.db
*.tmp

# Editor noise
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# TypeScript build cache
*.tsbuildinfo

# Logs
*.log

# Command Code agent tooling (auto-managed — never commit)
.commandcode/

# Environment variables (never commit secrets)
.env
.env.local
.env.*.local

# Vendored upstream documentation mirrors (bun run docs:sync).
# ~200 MB of third-party repos under their own licenses — the manifest in
# scripts/sync-docs.ts is the committed source of truth, not the checkout.
.docs/

# Playwright MCP session scratch output
.playwright-mcp/
